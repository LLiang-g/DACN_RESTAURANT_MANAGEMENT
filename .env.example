# Template only. Keep real values in your local/server .env; do not commit them.
# Docker Compose reads .env. An IDE/bootRun needs these values in its process environment.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=smart_pos_kds
MYSQL_PORT=3307
BACKEND_PORT=8080
CUSTOMER_PORT=5173
POS_PORT=5174
KDS_PORT=5175
ADMIN_PORT=5176

# Java local launch (Compose supplies these separately; its DB port is MYSQL_PORT).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_pos_kds?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Required: Base64 of at least 32 cryptographically random bytes.
JWT_SECRET=

# Enable only after filling your own merchant credentials and reachable callback URLs.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
PUBLIC_BASE_URL=http://localhost:8080
CUSTOMER_PUBLIC_BASE_URL=http://localhost:5173
PAYMENT_RECONCILE_ENABLED=false

PAYMENT_MOCK_ENABLED=false
MOCK_WEBHOOK_SECRET=

# Demo seeding controls Java account seeder; does not disable SQL init sample data.
DEMO_ACCOUNTS_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_KITCHEN_PASSWORD=

# Local debugging flags. The deploy override forces these false.
SHOW_SQL=false
API_DOCS_ENABLED=false

# Server only: bare domain without scheme/path; leave empty until you have a domain.
DEPLOY_DOMAIN=
