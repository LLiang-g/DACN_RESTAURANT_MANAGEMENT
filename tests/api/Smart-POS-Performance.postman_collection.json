    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "fixtureBaseUrl",
      "value": ""
    },
    {
      "key": "enableFixtureWrites",
      "value": "false"
    },
    {
      "key": "tableId",
      "value": "1"
    },
    {
      "key": "foodId",
      "value": ""
    },
    {
      "key": "txnRef",
      "value": ""
    },
    {
      "key": "posToken",
      "value": ""
    },
    {
      "key": "kitchenToken",
      "value": ""
    },
    {
      "key": "posUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "posPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "kitchenUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "kitchenPassword",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 Đăng nhập chuẩn bị token",
      "description": "Điền thông tin tài khoản thử, bấm Send từng request đăng nhập phù hợp. Token được lưu ở biến collection để các folder sử dụng.",
      "item": [
        {
          "name": "POS login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{loginPayload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!String(pm.variables.get('posPassword') || '').trim()) {",
                  "    throw new Error('Set posPassword using a test account.');",
                  "}",
                  "if (!String(pm.variables.get('posUsername') || '').trim()) {",
                  "    throw new Error('Set posUsername using a test account.');",
                  "}",
                  "pm.variables.set('loginPayload', JSON.stringify({username: pm.variables.get('posUsername'), password: pm.variables.get('posPassword')}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JWT and role', () => { const d=pm.response.json(); pm.expect(d.role).to.eql('RECEPTIONIST'); pm.expect(d.token).to.be.a('string').and.not.empty; pm.collectionVariables.set('posToken',d.token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Kitchen login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{loginPayload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!String(pm.variables.get('kitchenPassword') || '').trim()) {",
                  "    throw new Error('Set kitchenPassword using a test account.');",
                  "}",
                  "if (!String(pm.variables.get('kitchenUsername') || '').trim()) {",
                  "    throw new Error('Set kitchenUsername using a test account.');",
                  "}",
                  "pm.variables.set('loginPayload', JSON.stringify({username: pm.variables.get('kitchenUsername'), password: pm.variables.get('kitchenPassword')}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JWT and role', () => { const d=pm.response.json(); pm.expect(d.role).to.eql('KITCHEN'); pm.expect(d.token).to.be.a('string').and.not.empty; pm.collectionVariables.set('kitchenToken',d.token); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "PERF-01 QR và thực đơn",
      "description": "Kiểm tra cả hai request trả HTTP 200 trước khi đo. Chọn tableId của bàn có thật.",
