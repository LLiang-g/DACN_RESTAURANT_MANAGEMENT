    {
      "name": "PERF-06 Gửi đơn và gửi lại",
      "description": "Mặc định bỏ qua ghi dữ liệu. Chỉ bật enableFixtureWrites trên dữ liệu thử, đặt fixtureBaseUrl trùng baseUrl, điền tableId và foodId. Một vòng tạo đúng một đơn mới nếu thành công, sau đó gửi lại. Theo dõi số suất còn lại khi đo lặp.",
      "item": [
        {
          "name": "Tạo đơn với UUID mới",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customer/orders",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{orderKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": {{tableId}},\n  \"items\": [\n    {\n      \"foodId\": {{foodId}},\n      \"quantity\": 1,\n      \"optionIds\": []\n    }\n  ],\n  \"combos\": []\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get('baseUrl');",
                  "if (pm.variables.get('enableFixtureWrites') !== 'true' || !/^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(base) || base !== pm.variables.get('fixtureBaseUrl')) {",
                  "    pm.execution.skipRequest();",
                  "}",
                  "if (!/^[1-9][0-9]*$/.test(String(pm.variables.get('foodId')))) throw new Error('Set foodId to a positive integer.');",
                  "if (!/^[1-9][0-9]*$/.test(String(pm.variables.get('tableId')))) throw new Error('Set tableId to a positive integer.');",
                  "pm.variables.unset('firstOrderId');",
                  "pm.variables.set('orderKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test('Có mã đơn mới', () => {",
                  "    const id = pm.response.json().orderId;",
                  "    pm.expect(id).to.be.a('number');",
                  "    pm.variables.set('firstOrderId', id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi lại cùng UUID và nội dung",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customer/orders",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{orderKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": {{tableId}},\n  \"items\": [\n    {\n      \"foodId\": {{foodId}},\n      \"quantity\": 1,\n      \"optionIds\": []\n    }\n  ],\n  \"combos\": []\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get('baseUrl');",
                  "if (pm.variables.get('enableFixtureWrites') !== 'true' || !/^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(base) || base !== pm.variables.get('fixtureBaseUrl')) {",
                  "    pm.execution.skipRequest();",
                  "}",
                  "if (!/^[1-9][0-9]*$/.test(String(pm.variables.get('foodId')))) throw new Error('Set foodId to a positive integer.');",
                  "if (!/^[1-9][0-9]*$/.test(String(pm.variables.get('tableId')))) throw new Error('Set tableId to a positive integer.');",
                  "if (!pm.variables.get('orderKey') || !pm.variables.get('firstOrderId')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test('Gửi lại trả cùng mã đơn', () => pm.expect(pm.response.json().orderId).to.eql(Number(pm.variables.get('firstOrderId'))));",
                  "pm.variables.unset('firstOrderId');",
                  "pm.variables.unset('orderKey');"
                ]
              }
            }
          ]
        }
      ]
