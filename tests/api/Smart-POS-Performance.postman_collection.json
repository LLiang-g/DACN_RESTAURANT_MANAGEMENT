              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!String(pm.variables.get('txnRef') || '').trim()) {",
                  "    throw new Error('Set txnRef to an existing MOCK transaction.');",
                  "}",
                  "if (!String(pm.variables.get('posToken') || '').trim()) {",
                  "    throw new Error('Send the corresponding login request to set posToken.');",
                  "}"
                ]
              }
            },
            {
